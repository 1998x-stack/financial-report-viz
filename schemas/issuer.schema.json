{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Financial Report Atlas issuer",
  "type": "object",
  "required": [
    "id",
    "legal_name",
    "name",
    "ticker",
    "market",
    "sector",
    "country"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "legal_name": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "market": {
      "type": "string"
    },
    "sector": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "currency": {
      "type": "string"
    },
    "description": {
      "type": "string"
    }
  }
}
